# Inner Monitoring - Variáveis de Ambiente
# Copie para .env e preencha os valores

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ============================================
# JWT
# ============================================
JWT_SECRET_KEY=your-256-bit-secret-key-here-min-32-chars

# ============================================
# API
# ============================================
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# SNMP Master Key (para criptografar credenciais)
# ============================================
SNMP_MASTER_KEY=your-256-bit-master-key-for-snmp-credentials
