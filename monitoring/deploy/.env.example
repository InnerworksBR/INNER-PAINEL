# ===========================================
# Inner Monitoring - Variáveis de Ambiente
# ===========================================
# COPIE ESTE ARQUIVO PARA .env.production E PREENCHA OS VALORES

# ===========================================
# DATABASE - PostgreSQL Connection String
# ===========================================
# Exemplo com SSL:
DATABASE_URL=Host=seu-postgres-host;Port=5432;Database=inner_monitoring;Username=inner_monitoring;Password=SENHA_AQUI;SSL Mode=Require;Trust Server Certificate=false

# ===========================================
# JWT - Autenticação (OBRIGATÓRIO)
# ===========================================
# Gere com: openssl rand -base64 48
# NUNCA use valores padrão em produção!
JWT_SECRET_KEY=GERE_SUA_CHAVE_AQUI_COM_OPENSLL

# ===========================================
# WORKER - Configuração do Worker
# ===========================================
# ID único deste worker (para ambientes com múltiplos workers)
WORKER_ID=prod-worker-01

# Intervalo em segundos para buscar novos jobs
WORKER_POLL_INTERVAL=5

# Duração do lease em segundos (tempo que o worker "segura" um job)
WORKER_LEASE_DURATION=60

# Máximo de tentativas por job antes de ir para dead letter
WORKER_MAX_ATTEMPTS=10

# ===========================================
# APLICAÇÃO
# ===========================================
# Ambiente: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# ===========================================
# LOGGING
# ===========================================
# Nível de log: Trace, Debug, Information, Warning, Error, Fatal
Serilog__MinimumLevel=Warning

# ===========================================
# NOTIFICAÇÕES (futuro)
# ===========================================
# Email/Slack para alertas
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
