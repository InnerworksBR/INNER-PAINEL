{
  "Collector": {
    "CycleIntervalSeconds": 60,
    "SnmpTimeoutMs": 3000,
    "SnmpRetries": 3,
    "MaxConcurrentProbes": 64,
    "MaxConcurrentPolling": 16,
    "MaxRequestsPerSecond": 200
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
