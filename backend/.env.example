# Supabase
SUPABASE_URL=SUA_URL_SUPABASE
SUPABASE_KEY=SUA_CHAVE_ANON_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_SUPABASE

# JWT
JWT_SECRET=SEU_SEGREDO_SUPER_SECRETO_PARA_JWT

# Encryption key for integration secrets (32 bytes hex)
# Used by crypto-service.ts to encrypt Zabbix passwords, MS365 client secrets, etc.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_SECRET_KEY=GERE_UMA_CHAVE_HEX_DE_32_BYTES

# Server
PORT=3001

# External APIs
GLPI_API_URL=SUA_URL_API_GLPI
GLPI_API_TOKEN=SEU_TOKEN_GLPI

ZABBIX_API_URL=SUA_URL_API_ZABBIX
ZABBIX_USER=SEU_USER_ZABBIX
ZABBIX_PASSWORD=SUA_SENHA_ZABBIX

MICROSOFT_GRAPH_TENANT_ID=SEU_TENANT_ID
MICROSOFT_GRAPH_CLIENT_ID=SEU_CLIENT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=SEU_CLIENT_SECRET

# Anthropic API (para geracao de documentos com IA)
ANTHROPIC_API_URL=https://sua-url-do-gateway/v1/messages
ANTHROPIC_API_KEY=sua_chave_api
ANTHROPIC_MODEL=claude-opus-5

# Bootstrap users - set only when running create_users.js
BOOTSTRAP_ADMIN_PASSWORD=SENHA_UNICA_ADMIN_BOOTSTRAP
BOOTSTRAP_CLIENT_PASSWORD=SENHA_UNICA_CLIENTE_BOOTSTRAP
