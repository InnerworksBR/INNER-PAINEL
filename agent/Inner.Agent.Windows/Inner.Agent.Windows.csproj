<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Inner.Agent.Windows</AssemblyName>
    <RootNamespace>Inner.Agent.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>InnerWorks</Authors>
    <Company>InnerWorks</Company>
    <Product>Inner Hyper-V Agent</Product>
    <Description>Agente Windows para coleta nativa de host Hyper-V e máquinas virtuais</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
