<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InnerNetworkAgent-Setup</AssemblyName>
    <RootNamespace>Inner.Network.Agent.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(AgentPackagePath)" LogicalName="Inner.Network.Agent.Setup.AgentPackage.zip" Condition="'$(AgentPackagePath)' != ''" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
</Project>
